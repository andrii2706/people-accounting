// «Військовий облік» — вивантаження працівників з 1С / BAS ЗУП.
// МОДУЛЬ ОБ'ЄКТА зовнішньої обробки (див. docs/1C.md: як створити обробку і додати її в 1С).
//
// Обробка реєструється як «Додаткова обробка» (Адміністрування → Друк, звіти та обробки →
// Додаткові звіти та обробки). Команда «Надіслати працівників» виконується за розкладом
// (кнопка «Розклад» у картці обробки) або з форми обробки вручну.
// Адреса, ключ і код ЄДРПОУ зберігаються в безпечному сховищі даних 1С (не в тексті обробки).
//
// Надсилаються лише кадрові дані: ПІБ, стать, дата народження, РНОКПП, табельний номер,
// посада, підрозділ, дати прийняття і звільнення. Військові дані за потреби додає програміст 1С
// (формат — у docs/1C.md, поле "military").

#Область ПрограммныйИнтерфейс

// Сведения для регистрации в «Дополнительные отчеты и обработки» (БСП).
Функция СведенияОВнешнейОбработке() Экспорт

	Сведения = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.4.1.1");
	Сведения.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	Сведения.Версия = "1.0";
	Сведения.Наименование = "Військовий облік: надсилання працівників";
	Сведения.Информация = "Щодня надсилає працівників у застосунок «Військовий облік».";
	// HTTPS-з'єднання з сервером застосунку недоступне в безпечному режимі
	Сведения.БезопасныйРежим = Ложь;

	Команда = Сведения.Команды.Добавить();
	Команда.Представление = "Надіслати працівників";
	Команда.Идентификатор = "НадіслатиПрацівників";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	Команда.ПоказыватьОповещение = Истина;

	Команда = Сведения.Команды.Добавить();
	Команда.Представление = "Налаштування підключення";
	Команда.Идентификатор = "Налаштування";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	Команда.ПоказыватьОповещение = Ложь;

	Возврат Сведения;

КонецФункции

// Вызывается БСП для команды «Надіслати працівників» (вручную или по расписанию).
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт

	Если ИдентификаторКоманды = "НадіслатиПрацівників" Тогда
		Владелец = ПараметрыВыполненияКоманды.ДополнительнаяОбработкаСсылка;
		Результат = НадіслатиПрацівників(ПрочитатиНалаштування(Владелец));
		ЗаписьЖурналаРегистрации("ВійськовийОблік.Надсилання",
			?(Результат.Успішно, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Ошибка), , ,
			Результат.Повідомлення);
		Если Не Результат.Успішно Тогда
			ВызватьИсключение Результат.Повідомлення;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Настройки: структура Адреса, Ключ, КодЄДРПОУ.
Функция ПрочитатиНалаштування(Владелец) Экспорт

	Налаштування = Новый Структура("Адреса, Ключ, КодЄДРПОУ", "", "", "");
	УстановитьПривилегированныйРежим(Истина);
	Дані = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Владелец, "ВійськовийОблік");
	УстановитьПривилегированныйРежим(Ложь);
	Если ТипЗнч(Дані) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Налаштування, Дані);
	КонецЕсли;
	Возврат Налаштування;

КонецФункции

Процедура ЗберегтиНалаштування(Владелец, Налаштування) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Владелец,
		Новый Структура("Адреса, Ключ, КодЄДРПОУ", СокрЛП(Налаштування.Адреса), СокрЛП(Налаштування.Ключ),
			СокрЛП(Налаштування.КодЄДРПОУ)), "ВійськовийОблік");
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Проверка ключа: GET …/ping. Возвращает структуру Успішно, Повідомлення.
Функция ПеревіритиПідключення(Налаштування) Экспорт

	Відповідь = ЗапитHTTP(Налаштування, "GET", "/ping", "");
	Если Відповідь.Код = 200 Тогда
		Дані = ПрочитатиJSONРядок(Відповідь.Тіло);
		Повідомлення = "Підключення працює: " + Дані.legalEntity + " (ЄДРПОУ " + Дані.edrpou + ")";
		Возврат Новый Структура("Успішно, Повідомлення", Истина, Повідомлення);
	КонецЕсли;
	Возврат Новый Структура("Успішно, Повідомлення", Ложь, ТекстПомилки(Відповідь));

КонецФункции

// Отправляет всех сотрудников организации частями по 500.
Функция НадіслатиПрацівників(Налаштування) Экспорт

	Если Не ЗначениеЗаполнено(Налаштування.Адреса) Или Не ЗначениеЗаполнено(Налаштування.Ключ) Тогда
		Возврат Новый Структура("Успішно, Повідомлення", Ложь,
			"Вкажіть адресу і ключ у «Налаштування підключення»");
	КонецЕсли;

	Працівники = ЗібратиПрацівників(Налаштування.КодЄДРПОУ);
	Если Працівники.Количество() = 0 Тогда
		Возврат Новый Структура("Успішно, Повідомлення", Ложь, "Не знайдено працівників організації");
	КонецЕсли;

	Розмір = 500;
	Надіслано = 0;
	Підсумок = "";
	Для Початок = 0 По Цел((Працівники.Количество() - 1) / Розмір) Цикл
		Частина = Новый Массив;
		Для Номер = Початок * Розмір По Мин(Працівники.Количество(), (Початок + 1) * Розмір) - 1 Цикл
			Частина.Добавить(Працівники[Номер]);
		КонецЦикла;
		Відповідь = ЗапитHTTP(Налаштування, "POST", "/employees",
			ЗаписатиJSONРядок(Новый Структура("employees", Частина)));
		Если Відповідь.Код <> 200 Тогда
			Возврат Новый Структура("Успішно, Повідомлення", Ложь,
				"Надіслано " + Надіслано + " з " + Працівники.Количество() + ". " + ТекстПомилки(Відповідь));
		КонецЕсли;
		Надіслано = Надіслано + Частина.Количество();
		Підсумок = ПідсумокЧастини(Відповідь.Тіло);
	КонецЦикла;

	Возврат Новый Структура("Успішно, Повідомлення", Истина,
		"Надіслано працівників: " + Надіслано + ". " + Підсумок);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сотрудники организации с кадровыми данными на сегодня (ЗУП 3 / BAS ЗУП).
Функция ЗібратиПрацівників(КодЄДРПОУ)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Сотрудник,
	|	Сотрудники.Код КАК ТабельныйНомер,
	|	ФизическиеЛица.Ссылка КАК ФизическоеЛицо,
	|	ФизическиеЛица.Наименование КАК ПолноеИмя,
	|	ФизическиеЛица.ДатаРождения КАК ДатаРождения,
	|	ФизическиеЛица.Пол КАК Пол,
	|	ФизическиеЛица.КодПоДРФО КАК РНОКПП,
	|	ЕСТЬNULL(ФИО.Фамилия, """") КАК Фамилия,
	|	ЕСТЬNULL(ФИО.Имя, """") КАК Имя,
	|	ЕСТЬNULL(ФИО.Отчество, """") КАК Отчество,
	|	ЕСТЬNULL(Кадровые.ТекущаяДолжность.Наименование, """") КАК Должность,
	|	ЕСТЬNULL(Кадровые.ТекущееПодразделение.Наименование, """") КАК Подразделение,
	|	Кадровые.ДатаПриема КАК ДатаПриема,
	|	Кадровые.ДатаУвольнения КАК ДатаУвольнения
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
	|		ПО Сотрудники.ФизическоеЛицо = ФизическиеЛица.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК Кадровые
	|		ПО Сотрудники.Ссылка = Кадровые.Сотрудник
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц.СрезПоследних КАК ФИО
	|		ПО Сотрудники.ФизическоеЛицо = ФИО.ФизическоеЛицо
	|ГДЕ
	|	НЕ Сотрудники.ПометкаУдаления
	|	И Кадровые.ДатаПриема > ДАТАВРЕМЯ(1, 1, 1)
	|	И (&КодЄДРПОУ = """" ИЛИ Кадровые.ТекущаяОрганизация.КодПоЕДРПОУ = &КодЄДРПОУ)";
	Запрос.УстановитьПараметр("КодЄДРПОУ", СокрЛП(КодЄДРПОУ));

	Працівники = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запис = Новый Структура;
		Запис.Вставить("externalId", Строка(Выборка.Сотрудник.УникальныйИдентификатор()));
		Запис.Вставить("personnelNumber", СокрЛП(Выборка.ТабельныйНомер));
		Запис.Вставить("lastName", СокрЛП(Выборка.Фамилия));
		Запис.Вставить("firstName", СокрЛП(Выборка.Имя));
		Запис.Вставить("middleName", СокрЛП(Выборка.Отчество));
		Запис.Вставить("fullName", СокрЛП(Выборка.ПолноеИмя));
		Запис.Вставить("rnokpp", СокрЛП(Выборка.РНОКПП));
		Запис.Вставить("birthDate", Дата8601(Выборка.ДатаРождения));
		Запис.Вставить("gender", ?(Выборка.Пол = Перечисления.ПолФизическогоЛица.Женский, "F",
			?(Выборка.Пол = Перечисления.ПолФизическогоЛица.Мужской, "M", "")));
		Запис.Вставить("position", СокрЛП(Выборка.Должность));
		Запис.Вставить("department", СокрЛП(Выборка.Подразделение));
		Запис.Вставить("hireDate", Дата8601(Выборка.ДатаПриема));
		Запис.Вставить("dismissalDate", Дата8601(Выборка.ДатаУвольнения));
		Працівники.Добавить(Запис);
	КонецЦикла;
	Возврат Працівники;

КонецФункции

Функция ЗапитHTTP(Налаштування, Метод, Шлях, Тіло)

	Адреса = СокрЛП(Налаштування.Адреса);
	Если Прав(Адреса, 1) = "/" Тогда
		Адреса = Лев(Адреса, СтрДлина(Адреса) - 1);
	КонецЕсли;
	Если Прав(Адреса, 10) = "/employees" Тогда
		Адреса = Лев(Адреса, СтрДлина(Адреса) - 10);
	КонецЕсли;
	Если Не СтрНачинаетсяС(НРег(Адреса), "https://") Тогда
		Возврат Новый Структура("Код, Тіло", 0, "Адреса має починатися з https://");
	КонецЕсли;
	БезСхеми = Сред(Адреса, 9);
	Позиція = СтрНайти(БезСхеми, "/");
	Хост = ?(Позиція = 0, БезСхеми, Лев(БезСхеми, Позиція - 1));
	Ресурс = ?(Позиція = 0, "", Сред(БезСхеми, Позиція)) + Шлях;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + СокрЛП(Налаштування.Ключ));
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Заголовки.Вставить("Accept", "application/json");

	Попытка
		З_єднання = Новый HTTPСоединение(Хост, 443, , , , 120, Новый ЗащищенноеСоединениеOpenSSL());
		Запит = Новый HTTPЗапрос(Ресурс, Заголовки);
		Если Метод = "POST" Тогда
			Запит.УстановитьТелоИзСтроки(Тіло, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
			Відповідь = З_єднання.ОтправитьДляОбработки(Запит);
		Иначе
			Відповідь = З_єднання.Получить(Запит);
		КонецЕсли;
		Возврат Новый Структура("Код, Тіло", Відповідь.КодСостояния, Відповідь.ПолучитьТелоКакСтроку());
	Исключение
		Возврат Новый Структура("Код, Тіло", 0, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

Функция ТекстПомилки(Відповідь)

	Если Відповідь.Код = 0 Тогда
		Возврат "Немає з'єднання: " + Відповідь.Тіло;
	КонецЕсли;
	Текст = "";
	Попытка
		Дані = ПрочитатиJSONРядок(Відповідь.Тіло);
		Если Дані.Свойство("message") Тогда
			Текст = ?(ТипЗнч(Дані.message) = Тип("Массив"), СтрСоединить(Дані.message, "; "), Строка(Дані.message));
		КонецЕсли;
	Исключение
		Текст = Лев(Відповідь.Тіло, 300);
	КонецПопытки;
	Возврат "Помилка " + Відповідь.Код + ": " + Текст;

КонецФункции

Функция ПідсумокЧастини(Тіло)

	Попытка
		Дані = ПрочитатиJSONРядок(Тіло);
		К = Дані.counts;
		Возврат "Нових: " + К.create + ", змін: " + К.update + ", звільнень: " + К.dismiss
			+ ?(Дані.status = "PENDING", " (чекає на перегляд у застосунку)", "");
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Функция Дата8601(Значення)

	Если Не ЗначениеЗаполнено(Значення) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Формат(Значення, "ДФ=yyyy-MM-dd");

КонецФункции

Функция ЗаписатиJSONРядок(Значення)

	Запис = Новый ЗаписьJSON;
	Запис.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запис, Значення);
	Возврат Запис.Закрыть();

КонецФункции

Функция ПрочитатиJSONРядок(Текст)

	Читання = Новый ЧтениеJSON;
	Читання.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Читання);
	Читання.Закрыть();
	Возврат Результат;

КонецФункции

#КонецОбласти
