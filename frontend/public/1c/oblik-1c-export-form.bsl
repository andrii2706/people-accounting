// «Військовий облік» — МОДУЛЬ ФОРМИ «Форма» зовнішньої обробки (див. docs/1C.md).
//
// Реквізити форми: Адреса, Ключ, КодЄДРПОУ (рядок; поле «Ключ» — з режимом пароля) і
// ДополнительнаяОбработка (СправочникСсылка.ДополнительныеОтчетыИОбработки, не показується).
// Команди форми: Зберегти, ПеревіритиПідключення, НадіслатиЗараз.
// Форма відкривається командою «Налаштування підключення» з картки додаткової обробки;
// параметр форми ОбъектНазначения / ДополнительнаяОбработкаСсылка передає БСП.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не Параметры.Свойство("ДополнительнаяОбработкаСсылка") Тогда
		ВызватьИсключение "Відкрийте обробку з «Додаткові звіти та обробки» — так налаштування збережуться безпечно";
	КонецЕсли;
	ДополнительнаяОбработка = Параметры.ДополнительнаяОбработкаСсылка;
	Налаштування = РеквизитФормыВЗначение("Объект").ПрочитатиНалаштування(ДополнительнаяОбработка);
	Адреса = Налаштування.Адреса;
	Ключ = Налаштування.Ключ;
	КодЄДРПОУ = Налаштування.КодЄДРПОУ;

КонецПроцедуры

&НаКлиенте
Процедура Зберегти(Команда)

	ЗберегтиНаСервері();
	ПоказатьОповещениеПользователя("Налаштування збережено");

КонецПроцедуры

&НаКлиенте
Процедура ПеревіритиПідключення(Команда)

	Результат = ПеревіритиНаСервері();
	ПоказатьПредупреждение(, Результат.Повідомлення);

КонецПроцедуры

&НаКлиенте
Процедура НадіслатиЗараз(Команда)

	Результат = НадіслатиНаСервері();
	ПоказатьПредупреждение(, Результат.Повідомлення);

КонецПроцедуры

&НаСервере
Процедура ЗберегтиНаСервері()

	РеквизитФормыВЗначение("Объект").ЗберегтиНалаштування(ДополнительнаяОбработка,
		Новый Структура("Адреса, Ключ, КодЄДРПОУ", Адреса, Ключ, КодЄДРПОУ));

КонецПроцедуры

&НаСервере
Функция ПеревіритиНаСервері()

	Возврат РеквизитФормыВЗначение("Объект").ПеревіритиПідключення(
		Новый Структура("Адреса, Ключ, КодЄДРПОУ", Адреса, Ключ, КодЄДРПОУ));

КонецФункции

&НаСервере
Функция НадіслатиНаСервері()

	Возврат РеквизитФормыВЗначение("Объект").НадіслатиПрацівників(
		Новый Структура("Адреса, Ключ, КодЄДРПОУ", Адреса, Ключ, КодЄДРПОУ));

КонецФункции
