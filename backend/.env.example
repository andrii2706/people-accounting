# =============================================================================
# Backend (NestJS). Copy to .env for local development: cp .env.example .env
# In production (Cloud Run) these variables are set by GitHub Actions, secrets come from Secret Manager.
# =============================================================================

NODE_ENV=development
PORT=3000

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/military
# Cloud SQL: postgres://api:PASS@/military?host=/cloudsql/PROJECT:REGION:INSTANCE
DB_MIGRATIONS_RUN=true          # false in production — migrations are run by a Cloud Run Job
DB_LOGGING=false

# --- Sessions -------------------------------------------------------------------
# Random string of ≥ 32 characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-please-very-long-random-string-0123456789
COOKIE_SECURE=false             # true in production (HTTPS only, cookie __Host-mr_session)
SESSION_IDLE_MINUTES=30         # sign-out after inactivity
SESSION_MAX_HOURS=10            # absolute session lifetime
MAX_FAILED_LOGINS=5             # lockout after N failed attempts
LOCKOUT_MINUTES=15

# --- Personal data encryption (AES-256-GCM + HMAC index for RNOKPP) -------------
# May be omitted in development (derived from JWT_SECRET). Mandatory in production,
# separate 32-byte keys: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠ Losing DATA_ENCRYPTION_KEY = losing the encrypted data. Keep it in Secret Manager.
DATA_ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# --- Network --------------------------------------------------------------------
CORS_ORIGIN=http://localhost:4200   # development only (ng serve); empty in production
APP_ORIGIN=                         # production frontend domain for the Origin check (CSRF)
TRUST_PROXY_HOPS=0                  # Cloud Run behind the SSR proxy: 2
SWAGGER=true                        # false in production

# --- Files (frozen documents and e-signatures) ----------------------------------
STORAGE_DRIVER=local                # local | gcs
STORAGE_LOCAL_DIR=storage/files
STORAGE_BUCKET=                     # for gcs: a bucket with a retention policy (infra/bootstrap.sh)

# --- E-signature: IIT signing widget (optional) ---------------------------------
# Without them signing works by uploading a .p7s file made by any program.
# Put eusign.js from the IIT widget package into frontend/public/iit/ (see docs/KEP.md).
SIGN_WIDGET_SCRIPT_URL=             # e.g. /iit/eusign.js
SIGN_WIDGET_FRAME_URL=              # e.g. https://eu.iit.com.ua/sign-widget/v20240301/
SIGN_VERIFY_URL=https://czo.gov.ua/verify

# --- First administrator (created at startup if it does not exist yet) -------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!         # use another one in production; the system asks to change it on first sign-in
ADMIN_NAME=Адміністратор
