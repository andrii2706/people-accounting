# =============================================================================
# Backend (NestJS). Скопіюйте у .env для локальної розробки: cp .env.example .env
# У продакшні (Cloud Run) ці змінні задає GitHub Actions, а секрети — Secret Manager.
# =============================================================================

NODE_ENV=development
PORT=3000

# --- База даних ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/military
# Cloud SQL: postgres://api:PASS@/military?host=/cloudsql/PROJECT:REGION:INSTANCE
DB_MIGRATIONS_RUN=true          # у продакшні false — міграції запускає Cloud Run Job
DB_LOGGING=false

# --- Сесії ----------------------------------------------------------------------
# Випадковий рядок ≥ 32 символів: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-please-very-long-random-string-0123456789
COOKIE_SECURE=false             # у продакшні true (лише HTTPS, cookie __Host-mr_session)
SESSION_IDLE_MINUTES=30         # вихід після бездіяльності
SESSION_MAX_HOURS=10            # абсолютна тривалість сесії
MAX_FAILED_LOGINS=5             # після N невдалих спроб — блокування
LOCKOUT_MINUTES=15

# --- Шифрування персональних даних (AES-256-GCM + HMAC-індекс для РНОКПП) --------
# У розробці можна не задавати (будуть похідні від JWT_SECRET). У продакшні — обов'язково,
# окремі 32-байтові ключі: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠ Втрата DATA_ENCRYPTION_KEY = втрата зашифрованих даних. Зберігайте в Secret Manager.
DATA_ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# --- Мережа -------------------------------------------------------------------
CORS_ORIGIN=http://localhost:4200   # лише для розробки (ng serve); у продакшні порожньо
APP_ORIGIN=                         # продакшн-домен фронтенду для перевірки Origin (CSRF)
TRUST_PROXY_HOPS=0                  # Cloud Run за SSR-проксі: 2
SWAGGER=true                        # у продакшні false

# --- Файли (зафіксовані документи і підписи КЕП) ------------------------------
STORAGE_DRIVER=local                # local | gcs
STORAGE_LOCAL_DIR=storage/files
STORAGE_BUCKET=                     # для gcs: бакет з retention policy (infra/bootstrap.sh)

# --- КЕП: віджет підпису ІІТ (необов'язково) ----------------------------------
# Без них підписання працює через завантаження файлу .p7s з будь-якої програми.
# Скрипт eusign.js з пакета віджета ІІТ покладіть у frontend/public/iit/ (див. docs/KEP.md).
SIGN_WIDGET_SCRIPT_URL=             # напр. /iit/eusign.js
SIGN_WIDGET_FRAME_URL=              # напр. https://eu.iit.com.ua/sign-widget/v20240301/
SIGN_VERIFY_URL=https://czo.gov.ua/verify

# --- Перший адміністратор (створюється під час старту, якщо його ще немає) -------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!         # у продакшні — інший; при першому вході система попросить змінити
ADMIN_NAME=Адміністратор

# --- Пошта (SMTP). Якщо SMTP_HOST порожній — листи зберігаються у storage/outbox як .eml
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Військовий облік <hr@example.com>"
MAIL_OUTBOX_DIR=
