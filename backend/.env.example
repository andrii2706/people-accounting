# =============================================================================
# Backend (NestJS). Copy to .env for local development: cp .env.example .env
# In production (Cloud Run) these variables are set by GitHub Actions, secrets come from Secret Manager.
# =============================================================================

NODE_ENV=development
# locally 3400: 3000 is usually taken by Next.js / React / Node of other projects (in containers — 3000)
PORT=3400

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/military
# Cloud SQL: postgres://api:PASS@/military?host=/cloudsql/PROJECT:REGION:INSTANCE
DB_MIGRATIONS_RUN=true          # false in production — migrations are run by a Cloud Run Job
DB_LOGGING=false

# --- Sessions -------------------------------------------------------------------
# Random string of ≥ 32 characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-please-very-long-random-string-0123456789
# Together with the portal (one sign-in for all modules): the private key EC P-256 the session is signed with (ES256).
# Locally it is added by `npm run dev:setup` in the portal; in production — Secret Manager (docs/DEPLOYMENT.md).
# SESSION_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
COOKIE_SECURE=false             # true in production (HTTPS only, cookie __Host-mr_session)
SESSION_IDLE_MINUTES=30         # sign-out after inactivity
SESSION_MAX_HOURS=10            # absolute session lifetime
MAX_FAILED_LOGINS=5             # lockout after N failed attempts
LOCKOUT_MINUTES=15
# Two-step sign-in: after the password — a 6-digit code from an authenticator app (Google / Microsoft
# Authenticator, 1Password…). By default every role; a list (ADMIN,ENTITY_ADMIN,DIRECTOR,HR,VENDOR) or «none».
# Locally, for the perf scripts: MFA_REQUIRED_ROLES=none
# MFA_REQUIRED_ROLES=
# MFA_ISSUER=Військовий облік
# Downloaded files per account (0 — no limit); a letter to the administrators when reached
# EXPORT_LIMIT_PER_HOUR=60
# EXPORT_LIMIT_PER_DAY=300
# So many employee cards opened by one account within an hour → a letter to the administrators (0 — off)
# MASS_VIEW_ALERT_PER_HOUR=200
# More addresses for the security letters (besides the administrators of the legal entity and the main ones)
# SECURITY_ALERT_EMAILS=security@company.ua

# --- Personal data encryption (AES-256-GCM + HMAC index for RNOKPP) -------------
# May be omitted in development (derived from JWT_SECRET). Mandatory in production,
# separate 32-byte keys: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠ Losing DATA_ENCRYPTION_KEY = losing the encrypted data. Keep it in Secret Manager.
DATA_ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# --- Network --------------------------------------------------------------------
CORS_ORIGIN=http://localhost:4301   # development only (ng serve); empty in production
APP_ORIGIN=                         # production frontend domain for the Origin check (CSRF)
TRUST_PROXY_HOPS=0                  # Cloud Run behind the SSR proxy: 2
SWAGGER=true                        # false in production

# --- Files (frozen documents and e-signatures) ----------------------------------
STORAGE_DRIVER=local                # local | gcs
STORAGE_LOCAL_DIR=storage/files
STORAGE_BUCKET=                     # for gcs: a bucket with a retention policy (infra/bootstrap.sh)

# --- E-signature: IIT signing widget (optional) ---------------------------------
# Without them signing works by uploading a .p7s file made by any program.
# Put eusign.js from the IIT widget package into frontend/public/iit/ (see docs/KEP.md).
SIGN_WIDGET_SCRIPT_URL=             # e.g. /iit/eusign.js
SIGN_WIDGET_FRAME_URL=              # e.g. https://eu.iit.com.ua/sign-widget/v20240301/
SIGN_VERIFY_URL=https://czo.gov.ua/verify

# --- First administrator (created at startup if it does not exist yet) -------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!         # use another one in production; the system asks to change it on first sign-in
ADMIN_NAME=Адміністратор

# --- E-mail (reminders: deferrals 5 days before, reservations, mobilization; user account letters) ---
# Without SMTP_URL letters are not sent — only written to the log.
# Gmail: smtps://user%40gmail.com:APP_PASSWORD@smtp.gmail.com:465  (App Password, not the account password)
# In production SMTP_URL is a Secret Manager secret (infra/bootstrap.sh), MAIL_FROM is a GitHub variable.
SMTP_URL=
MAIL_FROM=                          # e.g. "Військовий облік <hr@company.ua>"
APP_URL=                            # link in letters; defaults to the first APP_ORIGIN (locally with the portal: http://localhost:8400/oblik)
# Letters with a temporary password (access for the head / the responsible person, password reset) —
# from a separate mailbox; empty — from SMTP_URL / MAIL_FROM. In production ACCESS_SMTP_URL is a secret.
ACCESS_SMTP_URL=
ACCESS_MAIL_FROM=                   # e.g. "Військовий облік <access@company.ua>"
TEMPORARY_PASSWORD_HOURS=72         # a temporary password expires after this many hours
# Passwords of these roles are valid PASSWORD_MAX_AGE_DAYS (0 — forever); a letter with a link to change
# comes PASSWORD_REMINDER_DAYS before; after expiry the user is let in only to change the password.
PASSWORD_MAX_AGE_DAYS=180
PASSWORD_EXPIRY_ROLES=HR,DIRECTOR
PASSWORD_REMINDER_DAYS=30
PASSWORD_LINK_HOURS=72              # the link in «change your password» from the administrator
# Free ЄДР source for «Підтягнути з ЄДР» in the legal entity form ({code} — the EDRPOU); empty — lookup is off
COMPANY_REGISTRY_URL=https://adm.tools/action/gov/api/?egrpou={code}
# Source of the presidential decrees on extending mobilization (checked by the daily job)
DECREE_SOURCE_URL=https://zakon.rada.gov.ua/laws/show/65/2022
# Fallback when it does not answer (it often drops requests from cloud addresses): the newest decree
# «Про продовження строку проведення загальної мобілізації» in the list on president.gov.ua; empty — off
# DECREE_FALLBACK_URL=https://www.president.gov.ua/documents/decrees

# --- Self sign-up, subscriptions, own databases of clients ----------------------------
# «Зареєструвати компанію» on the sign-in page (the old flow — accounts by the administrator — stays);
# works only with a KEP check and the ЄДР lookup configured
SELF_SIGNUP_ENABLED=true
# Qualified e-signature check for the sign-up and the offer:
#   dstu — the open-source jkurwa, DSTU 4145 keys, chain to the ЦЗО list, OCSP (backend/kep/README.md);
#   basic — development only (no chain);
#   empty — sign-up off, offer not required
KEP_VERIFIER=
# KEP_CA_URL=https://czo.gov.ua/download/certificates/CACertificates.p7b
# KEP_CA_FILE=kep/CACertificates.p7b
# KEP_OCSP=strict            # strict | lax
# OFFER_REQUIRED_FOR=self    # self — only self-registered legal entities sign the offer; all — every one
# The own PostgreSQL of a client: private / loopback / metadata addresses are refused unless true.
# Default: true outside production (local tests), false in production.
# ALLOW_PRIVATE_DB_HOSTS=false
