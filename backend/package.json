{
  "name": "military-registry-backend",
  "version": "0.0.1",
  "description": "API військового обліку на підприємстві (NestJS + TypeORM + PostgreSQL)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "typeorm": "tsx --env-file-if-exists=.env node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:generate": "tsx --env-file-if-exists=.env node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
    "migration:run": "tsx --env-file-if-exists=.env node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:revert": "tsx --env-file-if-exists=.env node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "seed": "nest build && node --env-file-if-exists=.env dist/database/seed.js",
    "dev:sign": "tsx scripts/dev-sign.ts",
    "job:daily": "nest build && node --env-file-if-exists=.env dist/jobs/daily.js",
    "tck:export": "tsx --env-file-if-exists=.env scripts/tck-export.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "asn1js": "^4.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "docx": "^9.14.0",
    "exceljs": "^4.4.0",
    "gost89": "^0.1.12",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pkijs": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "shevchenko": "^3.2.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "multer": "^2.5.0",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
